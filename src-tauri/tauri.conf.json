{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VISION LAB",
  "version": "0.1.1",
  "identifier": "com.visionlab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VISION/LAB",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; img-src 'self' asset: data: blob:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../models/rfdetr-nano/model.onnx": "detector/model.onnx",
      "../models/rfdetr-nano/config.json": "detector/config.json",
      "../models/rfdetr-nano/preprocessor_config.json": "detector/preprocessor_config.json",
      "../models/rfdetr-nano/checksums.json": "detector/checksums.json",
      "../third-party/THIRD-PARTY-NOTICES.md": "notices/THIRD-PARTY-NOTICES.md",
      "../third-party/RUST-DEPENDENCY-LICENSES.md": "notices/RUST-DEPENDENCY-LICENSES.md",
      "../third-party/licenses/": "notices/licenses/",
      "../third-party/vc-runtime/x64/msvcp140.dll": "msvcp140.dll",
      "../third-party/vc-runtime/x64/msvcp140_1.dll": "msvcp140_1.dll",
      "../third-party/vc-runtime/x64/vcruntime140.dll": "vcruntime140.dll",
      "../third-party/vc-runtime/x64/vcruntime140_1.dll": "vcruntime140_1.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
